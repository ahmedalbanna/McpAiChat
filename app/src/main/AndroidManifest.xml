<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.McpAiChat">

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.ConversationListActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ServersActivity"
            android:exported="false"
            android:label="@string/title_servers"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.ToolDetailActivity"
            android:exported="false"
            android:label="@string/title_tools"
            android:parentActivityName=".ui.ServersActivity" />

        <activity
            android:name=".ui.ServerEditActivity"
            android:exported="false"
            android:label="@string/action_new_server"
            android:parentActivityName=".ui.ServersActivity" />

        <activity
            android:name=".ui.CatalogActivity"
            android:exported="false"
            android:label="@string/title_free_servers"
            android:parentActivityName=".ui.ServersActivity" />
    </application>

</manifest>
