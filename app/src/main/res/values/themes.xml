<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Colour roles. The theme inherits Material3 DayNight, so every surface,
      outline and on-* role adapts to the system light/dark setting; the brand
      colours below are the app's identity on top of it.
    -->
    <style name="Theme.McpAiChat" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!--
      TYPOGRAPHY SCALE
      Material 3 sizes with Arabic-aware line spacing. Arabic needs a taller
      line box than Latin because of its ascenders, descenders and tashkeel,
      so body text gets a 1.35-1.4 multiplier and labels 1.25.
    -->

    <style name="TextAppearance.McpAiChat.DisplaySmall" parent="">
        <item name="android:textSize">36sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.McpAiChat.HeadlineSmall" parent="">
        <item name="android:textSize">24sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.McpAiChat.TitleLarge" parent="">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.McpAiChat.TitleMedium" parent="">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.McpAiChat.TitleSmall" parent="">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.McpAiChat.BodyLarge" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.McpAiChat.BodyMedium" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.McpAiChat.BodySmall" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.McpAiChat.LabelLarge" parent="">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.McpAiChat.LabelMedium" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="TextAppearance.McpAiChat.LabelSmall" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Semantic aliases used across the screens. -->
    <style name="TextAppearance.McpAiChat.ItemTitle" parent="TextAppearance.McpAiChat.TitleMedium" />

    <style name="TextAppearance.McpAiChat.ItemMeta" parent="TextAppearance.McpAiChat.BodySmall">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="TextAppearance.McpAiChat.SectionHeader" parent="TextAppearance.McpAiChat.LabelLarge">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.McpAiChat.Bubble" parent="TextAppearance.McpAiChat.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.McpAiChat.ToolName" parent="TextAppearance.McpAiChat.TitleSmall" />

    <style name="TextAppearance.McpAiChat.Meta" parent="TextAppearance.McpAiChat.ItemMeta" />

    <style name="TextAppearance.McpAiChat.Code" parent="TextAppearance.McpAiChat.BodySmall">
        <item name="android:fontFamily">monospace</item>
    </style>

    <!--
      Chat bubbles and code blocks get their own shape so the chat screen and
      the tool cards stay visually distinct from the list cards.
    -->
    <style name="Widget.McpAiChat.Bubble" parent="">
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="Widget.McpAiChat.CodeBlock" parent="">
        <item name="android:padding">10dp</item>
    </style>

    <!--
      Compact ChatGPT-style controls. The inner button stays around 40dp so the
      composer stays visually quiet; each remains a Material icon button with a
      visible ripple and accessible content description.
    -->
    <style name="Widget.McpAiChat.ComposerIconButton" parent="Widget.Material3.Button.IconButton">
        <item name="backgroundTint">@color/composer_icon_bg</item>
        <item name="iconTint">@color/composer_icon_fg</item>
        <item name="iconSize">20dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.McpAiChat.ComposerSendButton" parent="Widget.Material3.Button.IconButton">
        <item name="backgroundTint">@color/composer_send_background</item>
        <item name="iconTint">@color/composer_send_foreground</item>
        <item name="iconSize">20dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.McpAiChat.ComposerVoiceButton" parent="Widget.Material3.Button.IconButton">
        <item name="backgroundTint">@color/composer_voice_bg</item>
        <item name="iconTint">@color/composer_voice_on</item>
        <item name="iconSize">20dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

</resources>
