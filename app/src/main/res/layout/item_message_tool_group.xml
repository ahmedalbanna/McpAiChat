<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="7dp"
    android:paddingEnd="60dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:id="@+id/toolGroupHeader"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="?android:selectableItemBackgroundBorderless">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/icon_container"
            android:contentDescription="@null"
            android:padding="5dp"
            android:src="@drawable/ic_tools"
            app:tint="?attr/colorPrimary" />

        <ImageView
            android:id="@+id/toolGroupChevron"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_chevron_right" />

        <TextView
            android:id="@+id/toolGroupSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.McpAiChat.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Tools used: 3 · Calls: 3" />

        <ProgressBar
            android:id="@+id/toolGroupProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="2dp"
            android:indeterminateTint="?attr/colorPrimary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/toolGroupDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="2dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/toolGroupCalls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.15"
            android:textAppearance="@style/TextAppearance.McpAiChat.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textIsSelectable="true"
            tools:text="Reading get_doc Read...\nChecking fields get_meta Read...\nEditing update_doc Updated..." />
    </LinearLayout>
</LinearLayout>
