<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="60dp"
    android:paddingTop="5dp"
    android:paddingEnd="12dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:id="@+id/attachmentPreview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/attachment_chip_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/attachmentIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_attach"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/attachmentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:maxWidth="380dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.McpAiChat.LabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="document.pdf" />
    </LinearLayout>

    <TextView
        android:id="@+id/bubble"
        style="@style/Widget.McpAiChat.Bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="560dp"
        android:background="@drawable/bubble_user"
        android:breakStrategy="high_quality"
        android:hyphenationFrequency="none"
        android:textAppearance="@style/TextAppearance.McpAiChat.Bubble"
        android:textColor="@color/bubble_user_text"
        android:textIsSelectable="true"
        tools:text="What can you do?" />
</LinearLayout>
