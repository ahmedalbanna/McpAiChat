<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/attachmentName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:textAppearance="@style/TextAppearance.McpAiChat.Meta"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:text="document.pdf"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/bubble"
        style="@style/Widget.McpAiChat.Bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_user"
        android:textColor="@color/bubble_user_text"
        tools:text="What can you do?" />

</LinearLayout>
