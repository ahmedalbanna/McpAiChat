<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="5dp"
    android:paddingEnd="60dp"
    android:paddingBottom="5dp">

    <TextView
        android:id="@+id/reasoning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="560dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/reasoning_block"
        android:paddingStart="12dp"
        android:paddingTop="9dp"
        android:paddingEnd="12dp"
        android:paddingBottom="9dp"
        android:breakStrategy="high_quality"
        android:hyphenationFrequency="none"
        android:textAppearance="@style/TextAppearance.McpAiChat.BodySmall"
        android:textStyle="italic"
        android:textIsSelectable="true"
        android:visibility="gone"
        tools:text="We need to add 21 and 21, so the add tool is the right one."
        tools:visibility="visible" />

    <TextView
        android:id="@+id/bubble"
        style="@style/Widget.McpAiChat.Bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="560dp"
        android:background="@drawable/bubble_ai"
        android:breakStrategy="high_quality"
        android:hyphenationFrequency="none"
        android:textAppearance="@style/TextAppearance.McpAiChat.Bubble"
        android:textColor="@color/bubble_ai_text"
        android:textIsSelectable="true"
        tools:text="Sure — here is what I found." />
</LinearLayout>
