<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 6-11 full-backup rules.

  Both domains are excluded entirely:

  * The SharedPreferences file holds the OpenAI key, the MCP URLs and any
    authorization header — none of it may leave the device.
  * The conversation database — a stale restore once silently replaced the
    whole conversation history with an older backup after a reinstall.
    Conversations are worth keeping, but a blind restore destroying weeks of
    history is a worse failure mode than losing them. Users can
    export/import manually.

  The file name must match the one in EncryptedPreferences.create().
-->
<full-backup-content>
    <exclude
        domain="sharedpref"
        path="mcp_ai_chat_encrypted.xml" />
    <exclude
        domain="database"
        path="mcp_chat.db" />
</full-backup-content>
