<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup and device-transfer rules.

  Same intent as backup_rules.xml: secrets in the SharedPreferences are
  excluded from both cloud backup and device-to-device transfer, while the
  conversation database is kept.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="mcp_ai_chat.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="mcp_ai_chat.xml" />
    </device-transfer>
</data-extraction-rules>
